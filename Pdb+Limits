apiVersion: policy/v1
kind: PodDisruptionBudget
metadata:
  name: payment-api-pdb
  namespace: production
spec:
  minAvailable: 2           # at least 2 of 4 replicas must stay up
  selector:
    matchLabels:
      app: nginx      


---

apiVersion: v1
kind: Pod
metadata:
    name: pod-cpu-overload
spec:
    containers:
    - name: cpu-overload
      image: python:3.11-slim
      command: ["python3","-c"]
      args:
      - |
        import multiprocessing as mp
        import os

        def burn():
            x = 0
            while True:
                x = x * x + 1  # tight loop, never yields

        workers = os.cpu_count() or 1
        print(f"spawning {workers} CPU burners", flush=True)
        procs = [mp.Process(target=burn) for _ in range(workers)]
        for p in procs:
            p.start()
        for p in procs:
            p.join()
      resources:
        requests:
          cpu: "1000m"
        limits:
          cpu: "1"

---
apiVersion: v1
kind: Pod
metadata: 
    name: pod-oomkill
spec: 
    containers: 
    - name: memory-overload 
      image: python:3.11-slim
      command: ["python3","-c"]
      args:
      - |
        import time

        CHUNK = 10 * 1024 * 1024  # 10 MB
        held = []
        total = 0
        while True:
            block = bytearray(CHUNK)
            # touch every page so the kernel actually backs it with RAM
            for i in range(0, CHUNK, 4096):
                block[i] = 1
            held.append(block)
            total += CHUNK
            print(f"allocated {total // (1024 * 1024)} MB", flush=True)
            time.sleep(1)
      resources:
        requests:
          memory: "100Mi"
        limits:
          memory: "100Mi"
        
