apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRole
metadata: 
    name: admin-role
rules:
- apiGroups: ["*"] 
  resources: ["*"]
  verbs: ["*"]


---

apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: admin-crole
subjects:
- kind: ServiceAccount
  name: my-sa
  namespace: default
roleRef: 
  kind: ClusterRole
  name: admin-role 
  apiGroup: rbac.authorization.k8s.io
